map $args $infinite_canvas_login_query {
    default 0;
    ~*(^|&)(token|access_token|user_id)= 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name canvas.fo2.us.ci;
    server_tokens off;
    client_max_body_size 100m;

    access_log off;
    error_log /var/log/nginx/infinite-canvas.error.log crit;

    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "frame-ancestors 'self' https://aihub.fo2.us.ci https://aihubdirect.fo2.us.ci https://epoint2api.fjmooo.cn https://yunhop.cc https://www.yunhop.cc" always;
    add_header Cache-Control "no-store" always;

    # Sub2API menu credentials are unused by this browser-only application.
    if ($infinite_canvas_login_query) {
        return 302 https://$host$uri;
    }

    # Fixed Sub2API target; the caller supplies their own model API key.
    location ~ ^/(v1|v1beta)/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host aihub.fo2.us.ci;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
    }

    location / {
        proxy_pass http://127.0.0.1:9877;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
