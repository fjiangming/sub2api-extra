# 本服务可访问的 Sub2API 地址。
SUB2API_BASE_URL=http://host.docker.internal:8080

# 可选：Sub2API 数据库只读连接，用于统计各分组最近 5 小时的缓存率。
# 建议复用运营中心的只读连接；留空时仍可查看检测结果和分组倍率。
SUB2API_DATABASE_URL=

# 可选：瞬时故障自动补测次数（0-3，默认 2）；结果未知的断流最多补测一次。
# 补测会重新请求原模型，可能产生额外消费；0 关闭补测，仍保留安全重连。
DEGRADATION_DETECTOR_RECOVERY_RETRIES=2
# 所有请求和退避的总时限（秒，60-7200，默认 3600）；单次请求最多 1800 秒。
DEGRADATION_DETECTOR_RECOVERY_TIMEOUT_SECONDS=3600
