# Standalone service; the Sub2API database is always read-only.
NODE_ENV=production
USAGE_LEADERBOARD_PORT=9876
USAGE_LEADERBOARD_BIND_HOST=127.0.0.1

# Server-side Sub2API address; use host.docker.internal inside Docker.
SUB2API_BASE_URL=http://host.docker.internal:8080
# Browser-visible Sub2API root URL, also the allowed iframe parent.
SUB2API_PUBLIC_URL=https://sub2api.example.com
SUB2API_TIMEZONE=Asia/Shanghai
SUB2API_REQUEST_TIMEOUT_MS=10000

# Reuse an existing Sub2API read-only login or grant SELECT on the two tables.
# Passwords containing @, #, /, etc. must be URL encoded. No URL query parameters.
SUB2API_DATABASE_URL=postgresql://sub2api_read:replace-password@host.docker.internal:5432/sub2api
SUB2API_DATABASE_SSL=disable
USAGE_LEADERBOARD_DATABASE_CONNECTIONS=3
USAGE_LEADERBOARD_QUERY_TIMEOUT_MS=15000

# Enable only behind one trusted reverse proxy passing the real client address.
USAGE_LEADERBOARD_TRUST_PROXY=true
USAGE_LEADERBOARD_COOKIE_SECURE=true
# For Sub2API session binding: see README before enabling fingerprint forwarding.
SUB2API_FORWARD_CLIENT_FINGERPRINT=false

# All caches and sessions are in RAM, have fixed caps, and disappear on restart.
USAGE_LEADERBOARD_CACHE_SECONDS=60
USAGE_LEADERBOARD_PERSONAL_CACHE_ENTRIES=256
USAGE_LEADERBOARD_MAX_SESSIONS=1000
# Rolling idle window, renewed only after upstream validation; JWT exp still caps it.
USAGE_LEADERBOARD_SESSION_MINUTES=30
USAGE_LEADERBOARD_INCLUDE_ADMINS=false

# Optional: persist admin drafts/publications in one bounded settings file.
# Leave unset for memory-only mode (restart restores the actual leaderboard).
# Docker: uncomment the settings bind mount in compose.yaml and create the
# host directory with UID/GID 1000 ownership before using /app/settings.
# USAGE_LEADERBOARD_SETTINGS_DIR=/app/settings
