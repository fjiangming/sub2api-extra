VIDEO_ADAPTER_PORT=9875
VIDEO_ADAPTER_BIND_HOST=0.0.0.0
VIDEO_ADAPTER_MODE=production
VIDEO_ADAPTER_DATABASE_URL=postgresql://video_adapter:CHANGE_ME@host.docker.internal:5432/sub2api
VIDEO_ADAPTER_DATABASE_SSL=verify-full
VIDEO_ADAPTER_REDIS_URL=redis://:CHANGE_ME@host.docker.internal:6379/0
VIDEO_ADAPTER_CATALOG_PATH=/app/config/catalog.json
# Dedicated, balance-billed Sub2API groups. No subscription billing is allowed.
VIDEO_ADAPTER_GROUP_IDS=CHANGE_ME
# Existing Sub2API account used only for usage-log attribution, never forwarding.
VIDEO_ADAPTER_USAGE_ACCOUNT_ID=CHANGE_ME
# Generate a random 32-byte key, base64 encoded; keep it across restarts.
VIDEO_ADAPTER_ENCRYPTION_KEY=CHANGE_ME
VIDEO_ADAPTER_ADMIN_TOKEN=CHANGE_ME
VIDEO_ADAPTER_TIMEZONE=Asia/Shanghai
# Net realized USD per USD of user balance, after recharge discounts and fees.
VIDEO_ADAPTER_REVENUE_FACTOR=0.80
VIDEO_ADAPTER_MIN_MARGIN=0.20
VIDEO_ADAPTER_COST_BUFFER=0.10
VIDEO_ADAPTER_OVERHEAD_USD=0.01
VIDEO_ADAPTER_MAX_JOB_COST_USD=20
VIDEO_ADAPTER_DAILY_COST_BUDGET_USD=100
VIDEO_ADAPTER_MAX_ACTIVE_JOBS_PER_USER=2
# Maximum GET/Range requests per completed task; include their worst bandwidth cost above.
VIDEO_ADAPTER_MAX_DOWNLOADS_PER_JOB=4
VIDEO_ADAPTER_POLL_INTERVAL_MS=5000
VIDEO_ADAPTER_MAX_TASK_AGE_MS=86400000
VIDEO_ADAPTER_WORKER_CONCURRENCY=4
# Only set behind a proxy that overwrites X-Forwarded-For; use CIDRs, not true.
VIDEO_ADAPTER_TRUST_PROXY=
XCM_API_KEY=
LINGSU_API_KEY=
