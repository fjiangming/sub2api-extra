# Merge these locations into the existing HTTPS server for your relay domain.
# If Nginx runs in Docker, use video-adapter:9875 on the shared Docker network.
upstream sub2api_video_adapter {
    server 127.0.0.1:9875;
    keepalive 16;
}

# All video creation/status/download aliases go to the same financial gateway.
location = /v1/videos {
    proxy_pass http://sub2api_video_adapter;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 60s;
    client_max_body_size 20m;
}
location ^~ /v1/videos/ {
    proxy_pass http://sub2api_video_adapter;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 60s;
    proxy_buffering off;
    client_max_body_size 20m;
}

# Sub2API also exposes root video aliases; normalize them into the same gateway.
location = /videos {
    proxy_pass http://sub2api_video_adapter/v1/videos;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 60s;
    client_max_body_size 20m;
}
location ^~ /videos/ {
    proxy_pass http://sub2api_video_adapter/v1/videos/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 60s;
    proxy_buffering off;
    client_max_body_size 20m;
}

# Native Seedance task ingress is not covered by this adapter's funding contract.
# Block it when this service owns video ingress; use the unified /v1/videos API.
location ~ ^/(?:api/v3/|v3/|v1/)?contents/generations/tasks(?:/|$) {
    return 404;
}

# Dedicated catalog path; the main /v1/models remains served by Sub2API.
location = /video-api/v1/models {
    proxy_pass http://sub2api_video_adapter/v1/models;
    proxy_set_header X-Forwarded-For $remote_addr;
}

# Keep /admin private; no public proxy route is needed.
