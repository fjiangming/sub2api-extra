{
  "name": "sub2api-activity-center",
  "version": "1.0.0",
  "private": true,
  "description": "Activity center with durable recharge lottery and verified reward credits",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.cjs",
    "preview": "node scripts/preview.cjs",
    "test:browser": "node scripts/browser-check.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide": "^1.24.0",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": { "@electric-sql/pglite": "^0.3.14" }
}
