NODE_ENV=production
ACTIVITY_CENTER_PORT=9878
ACTIVITY_CENTER_PUBLIC_URL=https://activity.example.com
ACTIVITY_CENTER_DATA_DIR=./data
ACTIVITY_CENTER_TRUST_PROXY=true
ACTIVITY_CENTER_ENABLED=true

# First startup permanently sets the campaign start; historical redemptions are excluded.
# Preserve the data directory across restarts and updates.

SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_PUBLIC_URL=https://api.example.com
SUB2API_PUBLIC_URLS=
SUB2API_ADMIN_API_KEY=
SUB2API_REQUEST_TIMEOUT_MS=10000
SUB2API_FORWARD_CLIENT_FINGERPRINT=false
SUB2API_TIMEZONE=Asia/Shanghai

# Read used balance/admin_balance redemptions, matching operations-center's credit basis.
ACTIVITY_CENTER_RECHARGE_SOURCES=redemptions
# Required. Use a SELECT-only database account.
SUB2API_DATABASE_URL=
SUB2API_DATABASE_SSL=disable
