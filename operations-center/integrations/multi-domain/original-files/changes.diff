 # 供应商监控
--- a/etc/nginx/conf.d/infinite-canvas.conf
+++ b/etc/nginx/conf.d/infinite-canvas.conf
@@ -26,6 +26,12 @@
 
     # Fixed Sub2API target; the caller supplies their own model API key.
     location ~ ^/(v1|v1beta)/ {
+        add_header Referrer-Policy "no-referrer" always;
+        add_header X-Content-Type-Options "nosniff" always;
+        add_header Content-Security-Policy "frame-ancestors 'self' https://aihub.fo2.us.ci https://aihubdirect.fo2.us.ci https://epoint2api.fjmooo.cn https://yunhop.cc https://www.yunhop.cc" always;
+        add_header Cache-Control "no-store" always;
+        include /etc/nginx/snippets/canvas-api-cors.conf;
+
         proxy_pass http://127.0.0.1:9000;
         proxy_http_version 1.1;
         proxy_set_header Host aihub.fo2.us.ci;
--- /dev/null
+++ b/etc/nginx/snippets/sub2api-main-proxy.conf
@@ -0,0 +1,15 @@
+# Preserve the existing main-site proxy behavior for UI and model API routes.
+proxy_pass http://127.0.0.1:9000;
+proxy_ignore_client_abort on;
+proxy_set_header Host $host;
+proxy_set_header X-Real-IP $remote_addr;
+proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+proxy_set_header X-Forwarded-Proto $scheme;
+
+proxy_connect_timeout 60s;
+proxy_send_timeout 1860s;
+proxy_read_timeout 1860s;
+send_timeout 1860s;
+
+proxy_buffering off;
+proxy_request_buffering off;
--- /dev/null
+++ b/etc/nginx/snippets/canvas-api-cors.conf
@@ -0,0 +1,19 @@
+# Include only inside model API locations. API-key authentication stays upstream.
+proxy_hide_header Access-Control-Allow-Origin;
+proxy_hide_header Access-Control-Allow-Credentials;
+proxy_hide_header Access-Control-Allow-Methods;
+proxy_hide_header Access-Control-Allow-Headers;
+proxy_hide_header Access-Control-Expose-Headers;
+proxy_hide_header Access-Control-Max-Age;
+
+if ($canvas_api_preflight) {
+    add_header Access-Control-Allow-Origin $canvas_api_origin always;
+    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
+    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-API-Key, X-Goog-Api-Key" always;
+    add_header Vary Origin always;
+    return 204;
+}
+
+add_header Access-Control-Allow-Origin $canvas_api_origin always;
+add_header Access-Control-Expose-Headers "ETag, Server-Timing" always;
+add_header Vary Origin always;
