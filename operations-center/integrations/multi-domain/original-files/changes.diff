+# Only these browser origins may use the main/canvas model API across domains.
+map $http_origin $canvas_api_origin {
+    default "";
+    "https://aihub.fo2.us.ci" $http_origin;
+    "https://aihubdirect.fo2.us.ci" $http_origin;
+    "https://epoint2api.fjmooo.cn" $http_origin;
+    "https://yunhop.cc" $http_origin;
+    "https://www.yunhop.cc" $http_origin;
+    "https://canvas.fo2.us.ci" $http_origin;
+    "https://canvas.yunhop.cc" $http_origin;
+}
+
+map "$request_method:$canvas_api_origin" $canvas_api_preflight {
+    default 0;
+    ~^OPTIONS:https:// 1;
+}
