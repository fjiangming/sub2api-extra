# Compose
OPERATIONS_CENTER_IMAGE=ghcr.io/fjiangming/sub2api-extra:operations-center-latest
OPERATIONS_CENTER_CONTAINER_NAME=sub2api-operations-center
OPERATIONS_CENTER_RESTART_POLICY=unless-stopped
OPERATIONS_CENTER_PORT=9872

# Server and administrator login
NODE_ENV=production
OPERATIONS_CENTER_BIND_HOST=0.0.0.0
OPERATIONS_CENTER_DATA_DIR=./data
OPERATIONS_CENTER_DATABASE_SETUP_ENABLED=true
# sub2api: accept the signed-in administrator token supplied by a Sub2API custom menu.
# local: use the independent administrator account below.
OPERATIONS_CENTER_AUTH_MODE=sub2api
OPERATIONS_CENTER_ADMIN_USER=admin
# Required only in local mode; production passwords must contain at least 16 characters.
OPERATIONS_CENTER_ADMIN_PASSWORD=
OPERATIONS_CENTER_SESSION_TTL_MINUTES=120
OPERATIONS_CENTER_COOKIE_SECURE=false
OPERATIONS_CENTER_TRUST_PROXY=false

# Optional advanced deployment override. Leave blank to configure database access from System Settings.
SUB2API_DATABASE_URL=
SUB2API_DATABASE_SSL=disable

# Must match Sub2API's TIMEZONE/TZ setting. Current Sub2API default is Asia/Shanghai.
SUB2API_TIMEZONE=Asia/Shanghai
FINANCE_TIMEZONE=Asia/Shanghai

# Sub2API management API and browser URL. PUBLIC_URL is also the safe read/auth fallback when BASE_URL is unreachable.
# If host.docker.internal does not reach Sub2API on the server, set BASE_URL to the same public HTTPS URL.
SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_PUBLIC_URL=https://sub2api.example.com
# All credentials below are optional when SSO mode is opened from a signed-in Sub2API custom menu.
# Configure a managed token or account only when native-backup/automatic work must survive browser logout,
# access-token expiry, and service restarts. Prefer a managed token when the administrator uses 2FA.
SUB2API_ADMIN_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUB2API_REQUEST_TIMEOUT_MS=15000

# Read/query budget and bounded in-memory samples
OPERATIONS_CENTER_QUERY_TIMEOUT_MS=15000
OPERATIONS_CENTER_CACHE_TTL_SECONDS=60
OPERATIONS_CENTER_CAPACITY_SAMPLE_LIMIT=336
OPERATIONS_CENTER_CAPACITY_SAMPLE_INTERVAL_MINUTES=30

# Final retention policy
RETENTION_USAGE_LOGS_DAYS=30
RETENTION_USAGE_HOURLY_DAYS=30
RETENTION_USAGE_DAILY_DAYS=730
RETENTION_SYSTEM_LOG_DAYS=7
RETENTION_ERROR_LOG_DAYS=30
RETENTION_OPS_METRIC_DAYS=30
RETENTION_BACKUP_MAX_AGE_HOURS=24

# Destructive execution is off by default. Preview and reporting work while it is off.
OPERATIONS_CENTER_ENABLE_CLEANUP=false
OPERATIONS_CENTER_REQUIRE_FRESH_BACKUP=true
# Required only when execution is enabled. Use a separate role restricted to the cleanup whitelist.
SUB2API_MAINTENANCE_DATABASE_URL=
OPERATIONS_CENTER_PREVIEW_TTL_MINUTES=15
OPERATIONS_CENTER_CLEANUP_BATCH_SIZE=5000
OPERATIONS_CENTER_CLEANUP_BATCH_DELAY_MS=250
OPERATIONS_CENTER_CLEANUP_MAX_ROWS=5000000
OPERATIONS_CENTER_CLEANUP_TIMEOUT_MS=1800000

# Optional daily automatic cleanup. It reuses the same preview, coverage, backup and batch-delete gates.
OPERATIONS_CENTER_AUTO_CLEANUP_ENABLED=false
OPERATIONS_CENTER_AUTO_CLEANUP_TIME=03:30
# Critical usage targets must be added explicitly: usage_logs,usage_hourly,usage_daily
OPERATIONS_CENTER_AUTO_CLEANUP_TARGETS=system_logs,error_logs,ops_metrics
OPERATIONS_CENTER_AUTO_CLEANUP_BACKUP_WAIT_MINUTES=10
