# 个人转账自动充值最简生产配置
#
# 适用前提：Docker Compose + HTTPS 反向代理 + SMTP 587/STARTTLS。
# 使用方法：复制为 recharge-center/.env，替换全部示例值；不要删除安全验收闸门。
# 未完成真实小额端到端验收前，production + AUTO_MODE_VERIFIED=false 会拒绝启动。

# 作用：启用生产安全校验和生产默认值。填写：正式部署固定为 production。
NODE_ENV=production
# 作用：选择个人转账自动充值模式。填写：固定为 personal_transfer_auto。
RECHARGE_CENTER_PAYMENT_MODE=personal_transfer_auto
# 作用：加密账本敏感数据。填写：执行 openssl rand -hex 48，且不得与下面任何密钥复用。
RECHARGE_CENTER_SECRET=replace-with-at-least-48-random-characters
# 作用：充值中心对外 HTTPS 根地址。填写：替换成实际域名，不带路径和末尾斜杠。
RECHARGE_CENTER_PUBLIC_URL=https://pay.example.com
# 作用：信任本机受控反向代理提供的客户端地址。填写：按部署手册仅允许经反向代理访问时保持 true。
RECHARGE_CENTER_TRUST_PROXY=true

# 作用：让受控支付宝设备为每笔订单生成独立的不透明 fkx 收钱码。填写：固定为 collector。
RECHARGE_CENTER_TRANSFER_QR_SOURCE=collector
# 作用：只授权二维码代理领取金额和随机备注并回传收钱码。填写：再次执行 openssl rand -hex 48，且不得与任何其他密钥复用。
RECHARGE_CENTER_QR_PROVISIONER_SECRET=replace-with-a-dedicated-48-character-random-secret
# 作用：验证监听器 HMAC 签名。填写：再次执行 openssl rand -hex 48，必须与账本密钥不同。
RECHARGE_CENTER_LISTENER_SECRET=replace-with-a-different-48-character-random-secret
# 作用：只允许指定监听设备上报。填写：自行固定命名，只能使用字母、数字、下划线和连字符。
RECHARGE_CENTER_LISTENER_COLLECTOR_ID=alipay-ledger-device-1
# 作用：锁定真实收款账户。填写：从本人支付宝最终交易详情经正式监听适配器读取的稳定精确标识，不能猜测。
RECHARGE_CENTER_ALIPAY_RECIPIENT_ID=replace-with-exact-recipient-id
# 作用：生产自动放款验收闸门。填写：完成手册全部真实正向和负向测试后才改为 true。
RECHARGE_CENTER_AUTO_MODE_VERIFIED=false

# 作用：容器访问 Sub2API API 的内部地址。填写：Sub2API 与充值中心同机监听 8080 时通常保持此值。
SUB2API_BASE_URL=http://host.docker.internal:8080
# 作用：用户浏览器访问 Sub2API 的 HTTPS 根地址。填写：替换成现有 Sub2API 公网域名。
SUB2API_PUBLIC_URL=https://api.example.com
# 作用：自动生成并核销余额兑换码。填写：Sub2API 系统设置生成的专用 admin- 加 64 位十六进制 API Key。
SUB2API_ADMIN_API_KEY=admin-REPLACE_WITH_64_HEX_CHARACTERS

# 作用：异常订单必须通过独立邮件提醒。填写：自动模式固定至少包含 email。
RECHARGE_CENTER_ALERT_CHANNELS=email
# 作用：连接 SMTP 服务器。填写：邮箱服务商提供的 SMTP 主机；本最简配置使用默认 587/STARTTLS。
RECHARGE_CENTER_SMTP_HOST=smtp.example.com
# 作用：SMTP 登录账号。填写：邮箱服务商提供的完整邮箱或专用用户名。
RECHARGE_CENTER_SMTP_USER=recharge-alerts@example.com
# 作用：SMTP 登录凭据。填写：充值中心专用授权码或应用密码，不要使用邮箱网页登录密码。
RECHARGE_CENTER_SMTP_PASSWORD=replace-with-dedicated-smtp-app-password
# 作用：设置告警发件人。填写：SMTP 服务商允许使用的单个邮箱地址。
RECHARGE_CENTER_SMTP_FROM=recharge-alerts@example.com
# 作用：接收异常订单告警。填写：运维邮箱，多个地址使用英文逗号分隔。
RECHARGE_CENTER_ALERT_EMAIL_TO=operations@example.com
