# 个人静态收钱码 + 支付宝官方账务流水自动充值最简生产配置
# 复制为 recharge-center/.env 后逐项填写。未完成真实验收前保持 AUTO_MODE_VERIFIED=false。

# 作用：启用生产安全校验。填写：固定为 production。
NODE_ENV=production
# 作用：启用个人静态码账务流水模式。填写：固定为 personal_accountlog_static。
RECHARGE_CENTER_PAYMENT_MODE=personal_accountlog_static
# 作用：加密账本敏感数据并计算 HMAC。填写：执行 openssl rand -hex 48，且不得与任何其他密钥复用。
RECHARGE_CENTER_SECRET=replace-with-at-least-48-random-characters
# 作用：生成每单二维码中转地址。填写：充值中心实际 HTTPS 根域名，不带路径或末尾斜杠。
RECHARGE_CENTER_PUBLIC_URL=https://pay.example.com
# 作用：信任本机受控反向代理提供的客户端地址。填写：只允许经本机 Nginx 访问时保持 true。
RECHARGE_CENTER_TRUST_PROXY=true

# 作用：设置最终收款目标。填写：本人支付宝通用收钱码解出的完整 https://qr.alipay.com/fkx... 地址，不能使用预设金额码。
RECHARGE_CENTER_ALIPAY_STATIC_QR_URL=
# 作用：标识支付宝开放平台应用。填写：已获批 alipay.data.bill.accountlog.query 的应用 AppID。
RECHARGE_CENTER_ALIPAY_APP_ID=
# 作用：签署支付宝 API 请求。填写：保持容器路径；将应用私钥 PEM 放到 recharge-center/secrets/alipay-app-private-key.pem。
RECHARGE_CENTER_ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay-app-private-key.pem
# 作用：验证支付宝 API 响应。填写：保持容器路径；将控制台显示的“支付宝公钥”PEM 放到 recharge-center/secrets/alipay-public-key.pem。
RECHARGE_CENTER_ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay-public-key.pem
# 作用：生产自动放款验收闸门。填写：完成手册全部正向、负向和故障测试后才改为 true。
RECHARGE_CENTER_AUTO_MODE_VERIFIED=false

# 作用：容器访问 Sub2API API。填写：Sub2API 与充值中心同机监听 8080 时通常保持此值。
SUB2API_BASE_URL=http://host.docker.internal:8080
# 作用：用户浏览器访问 Sub2API。填写：现有 Sub2API HTTPS 根域名。
SUB2API_PUBLIC_URL=https://api.example.com
# 作用：自动生成并核销余额兑换码。填写：Sub2API 系统设置生成的专用 admin- 加 64 位十六进制 API Key。
SUB2API_ADMIN_API_KEY=admin-REPLACE_WITH_64_HEX_CHARACTERS

# 作用：异常订单必须发送独立通知。填写：固定至少包含 email。
RECHARGE_CENTER_ALERT_CHANNELS=email
# 作用：连接 SMTP 服务。填写：邮箱服务商提供的 SMTP 主机；默认端口 587 并强制 STARTTLS。
RECHARGE_CENTER_SMTP_HOST=smtp.example.com
# 作用：SMTP 登录账号。填写：邮箱服务商提供的完整邮箱或专用用户名。
RECHARGE_CENTER_SMTP_USER=recharge-alerts@example.com
# 作用：SMTP 登录凭据。填写：充值中心专用授权码或应用密码，不要使用网页登录密码。
RECHARGE_CENTER_SMTP_PASSWORD=replace-with-dedicated-smtp-app-password
# 作用：设置告警发件人。填写：SMTP 服务商允许使用的单个邮箱地址。
RECHARGE_CENTER_SMTP_FROM=recharge-alerts@example.com
# 作用：接收异常订单告警。填写：运维邮箱；多个地址使用英文逗号分隔。
RECHARGE_CENTER_ALERT_EMAIL_TO=operations@example.com
