# ========================= Compose 镜像与容器 =========================

# 作用：指定充值中心镜像。来源：项目 GitHub Container Registry；生产建议固定版本标签或镜像 digest，不要长期使用 latest。
RECHARGE_CENTER_IMAGE=ghcr.io/fjiangming/sub2api-extra:recharge-center-latest
# 作用：设置容器名称。来源：自行命名；同一 Docker 主机上必须唯一。
RECHARGE_CENTER_CONTAINER_NAME=sub2api-recharge-center
# 作用：设置 Docker 重启策略。来源：Docker Compose；生产通常使用 unless-stopped。
RECHARGE_CENTER_RESTART_POLICY=unless-stopped
# 作用：设置宿主机仅供反向代理访问的端口。来源：自行选择未占用端口；Compose 只绑定 127.0.0.1。
RECHARGE_CENTER_PORT=9874
# 作用：设置保存 SQLite 账本的 Docker 命名卷名称。来源：自行命名；升级时不要随意更换，否则会看到一套空账本。
RECHARGE_CENTER_DATA_VOLUME=sub2api-extra_recharge-center-data
# 作用：源码构建时可选指定 npm 镜像。来源：你的可信 npm 镜像地址；使用官方源时留空。
NPM_REGISTRY=

# ========================= 通用运行参数 =========================

# 作用：选择运行环境。来源：固定枚举 development、test、production；正式部署必须为 production。
NODE_ENV=production
# 作用：Node 进程监听端口。来源：自行选择；Compose 会固定覆盖为容器内 9874，只有直接运行 Node 时此项生效。
PORT=9874
# 作用：Node 进程监听地址。来源：自行设置；Compose 会固定覆盖为 0.0.0.0，且仅映射到宿主机 127.0.0.1。
RECHARGE_CENTER_BIND_HOST=0.0.0.0
# 作用：设置运行数据目录。来源：容器内路径；Compose 的命名卷挂载在 /app/data，因此保持 ./data。
RECHARGE_CENTER_DATA_DIR=./data
# 作用：设置 SQLite 账本文件。来源：容器内路径；留空时默认为 <DATA_DIR>/recharge-center.db。
RECHARGE_CENTER_DATABASE=./data/recharge-center.db
# 作用：加密备注并计算敏感字段 HMAC 的账本主密钥。来源：必须自行随机生成；生产至少 48 字符，且不能与任何其他密钥复用。
RECHARGE_CENTER_SECRET=replace-with-at-least-48-random-characters
# 作用：设置用户实际访问充值中心的公网根地址。来源：你为充值中心配置的反向代理 HTTPS 域名，不带路径、查询串或末尾斜杠。
RECHARGE_CENTER_PUBLIC_URL=https://pay.example.com
# 作用：决定是否信任反向代理转发的客户端地址。来源：部署拓扑；按本文档只经受控本机反向代理访问时设为 true。
RECHARGE_CENTER_TRUST_PROXY=true
# 作用：要求会话 Cookie 仅经 HTTPS 发送。来源：安全策略；生产必须为 true。
RECHARGE_CENTER_COOKIE_SECURE=true
# 作用：是否允许用户在充值中心再次输入 Sub2API 邮箱和密码。来源：安全策略；生产建议 false，只从 Sub2API 自定义菜单 SSO 进入。
RECHARGE_CENTER_PASSWORD_LOGIN_ENABLED=false
# 作用：设置充值中心本地会话有效分钟数。来源：自行制定；允许 5 到 240，默认 60。
RECHARGE_CENTER_SESSION_TTL_MINUTES=60
# 作用：设置官方模式和人工模式的订单有效分钟数。来源：业务规则；允许 3 到 60；自动个人转账模式始终固定 3 分钟并忽略此值。
RECHARGE_CENTER_ORDER_TTL_MINUTES=20
# 作用：设置待人工处理订单的保留小时数。来源：运营处理时限；允许 1 到 168，默认 72。
RECHARGE_CENTER_REVIEW_TTL_HOURS=72
# 作用：设置入账任务租约分钟数，用于进程异常后的幂等恢复。来源：内部容错参数；允许 1 到 30，通常保持 5。
RECHARGE_CENTER_FULFILLMENT_LEASE_MINUTES=5
# 作用：选择支付模式。来源：三选一 personal_manual、personal_transfer_auto、sub2api_official；首次放个人静态码请保持 personal_manual。
RECHARGE_CENTER_PAYMENT_MODE=personal_manual
# 作用：设置页面快捷金额，使用英文逗号分隔。来源：自行制定；最多 20 项，每项最多两位小数且必须位于最低和最高金额之间。
RECHARGE_CENTER_QUICK_AMOUNTS=10,20,50,100,200,500,1000,2000,5000
# 作用：旧版本快捷金额兼容项。来源：仅旧配置迁移时使用；QUICK_AMOUNTS 非空时本项会被忽略，新部署保持相同值即可。
RECHARGE_CENTER_ALLOWED_AMOUNTS=10,20,50,100,200,500,1000,2000,5000
# 作用：设置用户可输入的最低充值金额。来源：你的风控规则；人民币元，最多两位小数且必须大于 0。
RECHARGE_CENTER_MIN_AMOUNT=1
# 作用：设置用户可输入的最高充值金额。来源：你的风控和支付宝限额；人民币元，最多两位小数且不得低于最低金额。
RECHARGE_CENTER_MAX_AMOUNT=1000000
# 作用：设置实收金额与入账额度的倍率。来源：安全约束；只能为 1，确保收多少充多少并正确联动运营成本分析。
RECHARGE_CENTER_CREDIT_MULTIPLIER=1
# 作用：限制单个用户同时存在的活动订单数。来源：风控规则；允许 1 到 5，建议保持 1；自动模式另有不可调高的 100 笔全局占位上限。
RECHARGE_CENTER_MAX_ACTIVE_ORDERS=1

# ========================= 支付宝官方模式 =========================

# 作用：限制可使用的 Sub2API 官方支付宝服务商实例 ID，多个用英文逗号分隔。来源：Sub2API 支付服务商列表中 provider_key=alipay 的数字 id；仅 sub2api_official 必填。
RECHARGE_CENTER_OFFICIAL_ALIPAY_INSTANCE_IDS=
# 作用：设置官方订单主动查询间隔秒数。来源：轮询策略；允许 3 到 60，通常保持 5。
RECHARGE_CENTER_OFFICIAL_POLL_SECONDS=5
# 作用：限制官方订单同时查询数量。来源：容量规划；允许 1 到 20，通常保持 4。
RECHARGE_CENTER_OFFICIAL_POLL_CONCURRENCY=4

# ========================= 个人静态码人工模式 =========================

# 作用：指定静态个人支付宝收款码。来源：容器内路径，不是宿主机路径；宿主机文件必须放在 recharge-center/secrets/alipay-personal-qr.png。
ALIPAY_QR_IMAGE_PATH=/run/secrets/alipay-personal-qr.png
# 作用：限制收款码图片最大字节数，防止异常大文件。来源：安全上限；允许 1024 到 5242880，默认 2097152（2 MiB）。
ALIPAY_QR_MAX_BYTES=2097152

# ========================= 个人转账自动模式 =========================

# 作用：为每单动态生成带金额和随机备注的二维码。来源：从你自己的支付宝合法转账/分享流程取得并实测的 URI 模板；必须各含一次 {amount} 和 {memo}，静态收款码图片不能替代它。
RECHARGE_CENTER_TRANSFER_QR_TEMPLATE=
# 作用：验证监听器请求的 HMAC 密钥。来源：必须自行独立随机生成，至少 32 字符；只配置在充值中心和受控监听器中。
RECHARGE_CENTER_LISTENER_SECRET=
# 作用：锁定唯一允许上报的监听设备。来源：自行给设备命名，3 到 64 位，只能含字母、数字、下划线和连字符，例如 alipay-ledger-phone-1。
RECHARGE_CENTER_LISTENER_COLLECTOR_ID=
# 作用：监听心跳或最近成功查询超过多少秒即停止创建新订单。来源：采集频率；允许 5 到 300，监听器每 10 秒查询时建议 30。
RECHARGE_CENTER_LISTENER_MAX_STALE_SECONDS=30
# 作用：允许监听请求时间戳与服务端时间相差的秒数。来源：主机时钟同步质量；允许 15 到 300，默认 60。
RECHARGE_CENTER_LISTENER_SIGNATURE_TOLERANCE_SECONDS=60
# 作用：到账事件最迟可在付款后多少秒送达。来源：容错策略；允许 180 到 3600，默认 600；付款时间仍必须位于三分钟订单窗口内。
RECHARGE_CENTER_LISTENER_MAX_EVENT_AGE_SECONDS=600
# 作用：锁定实际收款账户，防止监听器把其他账户收入报给本服务。来源：真实支付宝最终交易详情经正式监听适配器读取的稳定精确标识，不能猜手机号、邮箱或昵称。
RECHARGE_CENTER_ALIPAY_RECIPIENT_ID=
# 作用：生产自动模式的人工验收闸门。来源：完成文档全部真实小额正向和负向测试后才改为 true；未完成时必须保持 false。
RECHARGE_CENTER_AUTO_MODE_VERIFIED=false

# ========================= Sub2API 连接 =========================

# 作用：充值中心容器访问 Sub2API API 的内部根地址。来源：你的容器网络；Sub2API 在同一宿主机 8080 端口时通常为 http://host.docker.internal:8080。
SUB2API_BASE_URL=http://host.docker.internal:8080
# 作用：用户浏览器实际访问 Sub2API 的公网根地址。来源：现有 Sub2API HTTPS 域名，不带路径、查询串或末尾斜杠。
SUB2API_PUBLIC_URL=https://api.example.com
# 作用：自动个人转账模式调用 create-and-redeem 的专用管理员 API Key。来源：Sub2API 管理后台“系统设置”的管理员 API Key；创建后只显示一次，生产格式为 admin- 加 64 位十六进制。
SUB2API_ADMIN_API_KEY=
# 作用：设置充值中心调用 Sub2API 的超时毫秒数。来源：内网质量；允许 1000 到 30000，默认 10000。
SUB2API_REQUEST_TIMEOUT_MS=10000
# 作用：向 Sub2API 转发用户 IP 和 User-Agent，便于校验自定义菜单令牌的会话绑定。来源：认证部署方式；受控反向代理部署通常保持 true。
SUB2API_FORWARD_CLIENT_FINGERPRINT=true

# ========================= 充值中心独立异常通知 =========================

# 作用：选择异常通知通道，多个用英文逗号分隔。来源：可填 email 或 email,webhook；自动个人转账模式强制包含 email，其他模式不用通知可留空。
RECHARGE_CENTER_ALERT_CHANNELS=
# 作用：单次通知投递超时毫秒数。来源：网络质量；允许 1000 到 30000，默认 5000。
RECHARGE_CENTER_ALERT_TIMEOUT_MS=5000
# 作用：SMTP 服务器主机名。来源：邮箱服务商“SMTP/客户端/第三方客户端”设置页；启用 email 时必填，不能写 URL。
RECHARGE_CENTER_SMTP_HOST=
# 作用：SMTP 端口。来源：邮箱服务商；SMTPS 通常为 465，STARTTLS 通常为 587。
RECHARGE_CENTER_SMTP_PORT=587
# 作用：是否从连接开始就使用 TLS。来源：邮箱服务商；465 通常为 true，587 通常为 false。
RECHARGE_CENTER_SMTP_SECURE=false
# 作用：是否强制 STARTTLS。来源：安全策略；587 应为 true；生产环境必须由 SECURE 或 REQUIRE_TLS 至少启用一个。
RECHARGE_CENTER_SMTP_REQUIRE_TLS=true
# 作用：SMTP 登录用户名。来源：邮箱服务商，通常是完整邮箱地址或专用 SMTP 用户名；不要复用其他服务账号。
RECHARGE_CENTER_SMTP_USER=
# 作用：SMTP 登录凭据。来源：邮箱服务商生成的客户端授权码或应用密码，优先不要使用邮箱网页登录密码，也不能与其他密钥复用。
RECHARGE_CENTER_SMTP_PASSWORD=
# 作用：告警邮件 From 地址。来源：邮箱服务商允许的发件地址；必须是单个纯邮箱地址。
RECHARGE_CENTER_SMTP_FROM=
# 作用：异常告警收件人。来源：自行指定运维邮箱；1 到 20 个地址用英文逗号分隔。
RECHARGE_CENTER_ALERT_EMAIL_TO=
# 作用：可选第二告警通道的接收地址。来源：你自建的通用 HTTPS Webhook；生产必须为 HTTPS，不允许 URL 内账号密码、片段或跳转。
RECHARGE_CENTER_ALERT_WEBHOOK_URL=
# 作用：Webhook Authorization Bearer Token。来源：必须自行独立随机生成，至少 32 字符，并在接收端配置相同值。
RECHARGE_CENTER_ALERT_WEBHOOK_BEARER_TOKEN=
